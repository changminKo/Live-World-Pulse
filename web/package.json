{
  "name": "lwp-web",
  "version": "0.1.0",
  "private": true,
  "description": "Live World Pulse 프론트 — Vite + React SPA. maplibre-gl은 ~5.24.0 핀: v6가 MapboxOverlay 의존 map.transform을 제거했고 @deck.gl/maplibre는 npm 미출시 (PR #10566). v6 업그레이드 금지.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "verify:globe": "node scripts/verify-globe.mjs",
    "verify:layers": "node scripts/verify-layers.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.10",
    "@deck.gl/layers": "^9.3.10",
    "@deck.gl/mapbox": "^9.3.10",
    "@deck.gl/mesh-layers": "^9.3.10",
    "maplibre-gl": "~5.24.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.8.0",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^7.1.0"
  }
}
