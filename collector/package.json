{
  "name": "lwp-collector",
  "version": "0.1.0",
  "private": true,
  "description": "Live World Pulse Phase 0a collector — Cloudflare Workers Cron + R2 (aircraft + earthquake)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail --format json",
    "bench:cpu": "esbuild bench/slot-cpu.ts --bundle --platform=node --format=esm --alias:@lwp/shared=../shared/src/index.ts --external:node:* --external:fflate --outfile=.bench/slot-cpu.mjs --log-level=warning && node .bench/slot-cpu.mjs",
    "bench:news": "esbuild bench/news-phases.ts --bundle --platform=node --format=esm --alias:@lwp/shared=../shared/src/index.ts --external:node:* --external:fflate --outfile=.bench/news-phases.mjs --log-level=warning && node .bench/news-phases.mjs",
    "bench:tcgeom": "esbuild bench/tc-geom-cpu.ts --bundle --platform=node --format=esm --alias:@lwp/shared=../shared/src/index.ts --external:node:* --external:fflate --outfile=.bench/tc-geom.mjs --log-level=warning && node .bench/tc-geom.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.124.0"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
